{
  "timeZone": "America/Toronto",
  "dependencies": {},
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/calendar.addons.execute",
    "https://www.googleapis.com/auth/calendar.addons.current.event.read",
    "https://www.googleapis.com/auth/calendar.readonly",
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/drive.addons.metadata.readonly",
    "https://www.googleapis.com/auth/script.locale"
  ],
  "addOns": {
    "common": {
      "name": "World Time & Overlap",
      "logoUrl": "https://www.gstatic.com/images/icons/material/system/2x/schedule_black_24dp.png",
      "useLocaleFromApp": true,
      "layoutProperties": {
        "primaryColor": "#1a73e8",
        "secondaryColor": "#188038"
      },
      "homepageTrigger": {
        "runFunction": "onHomepage",
        "enabled": true
      },
      "universalActions": [
        {
          "label": "Manage Locations & Settings",
          "runFunction": "onOpenSettings"
        },
        {
          "label": "Reset to Default Locations",
          "runFunction": "onResetDefaults"
        }
      ]
    },
    "calendar": {
      "eventOpenTrigger": {
        "runFunction": "onCalendarEventOpen"
      },
      "currentEventAccess": "READ"
    },
    "gmail": {},
    "drive": {
      "homepageTrigger": {
        "runFunction": "onHomepage",
        "enabled": true
      }
    }
  }
}
